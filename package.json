{
  "name": "frakio-work",
  "productName": "Frakio Work",
  "version": "1.2.2",
  "private": true,
  "license": "MIT",
  "description": "Frakio Work — a multi-runtime, multi-agent collaboration workspace.",
  "author": "MadsGao",
  "repository": {
    "type": "git",
    "url": "https://github.com/MadsGao/frakio-work.git"
  },
  "homepage": "https://github.com/MadsGao/frakio-work",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/desktop",
    "packages/contracts"
  ],
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix \"[{name}]\" --names \"api,web\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace @frakio/web",
    "dev:api": "npm run dev --workspace @frakio/api",
    "build": "npm run typecheck && npm run build --workspace @frakio/web",
    "typecheck": "tsc -b",
    "check:syntax": "node --check apps/api/server.mjs && node --check apps/desktop/main.cjs && node --check bin/hermes-workbench-mcp.mjs",
    "test": "node --test apps/api/*.test.mjs apps/api/lib/*.test.mjs apps/api/runtime/*.test.mjs apps/desktop/*.test.cjs scripts/*.test.mjs",
    "test:bridge": "node scripts/run-bridge-tests.mjs",
    "test:telemetry": "node --test apps/api/telemetry.test.mjs",
    "test:smoke": "node scripts/smoke-api.mjs",
    "verify:desktop-package": "node scripts/verify-desktop-package.mjs",
    "test:smoke:managed-package": "node scripts/smoke-managed-package.mjs",
    "test:e2e:release": "node scripts/e2e-release.mjs",
    "test:e2e:settings": "node scripts/e2e-settings.mjs",
    "test:e2e:desktop-update": "node scripts/e2e-desktop-update-badge.mjs",
    "test:e2e:launch": "node scripts/e2e-launch.mjs",
    "test:e2e:mode-control": "node scripts/e2e-mode-control.mjs",
    "test:e2e:plan-mode": "node scripts/e2e-plan-mode.mjs",
    "test:e2e:rich-content": "node scripts/e2e-rich-content.mjs",
    "test:e2e:stream-reveal": "node scripts/e2e-stream-reveal.mjs",
    "test:e2e:managed-web": "node scripts/e2e-managed-web.mjs",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "assets:build": "node scripts/build-icon.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "runtime:build": "node scripts/build-hermes-runtime.mjs",
    "web:package": "npm run notices:generate && npm run build && node scripts/package-managed-web.mjs",
    "web:service": "node bin/frakio-work-service.mjs",
    "preview": "npm run preview --workspace @frakio/web",
    "desktop:dev": "FRAKIO_WORK_DESKTOP=1 FRAKIO_WORK_DEV_SERVER_URL=http://127.0.0.1:5173 FRAKIO_WORK_EXTERNAL_API_URL=http://127.0.0.1:8787 electron .",
    "desktop:pack": "npm run assets:build && npm run prepare-runtime && npm run build && electron-builder --dir --publish never",
    "desktop:dist:mac": "npm run assets:build && npm run prepare-runtime && npm run build && electron-builder --mac dmg --publish never",
    "desktop:dist:win": "npm run assets:build && npm run prepare-runtime && npm run build && electron-builder --win nsis --x64 --publish never",
    "desktop:dist:win:arm64": "npm run assets:build && npm run prepare-runtime && npm run build && electron-builder --win nsis --arm64 --publish never",
    "clean": "node scripts/clean-generated.mjs",
    "desktop:clean": "node scripts/clean-generated.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "brace-expansion": "5.0.8",
    "beautiful-mermaid": "^1.1.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "playwright": "^1.61.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23",
    "tar": "7.5.22"
  },
  "build": {
    "appId": "com.frakio.work",
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/api/**/*",
      "!apps/api/**/*.test.mjs",
      "apps/desktop/**/*",
      "!apps/desktop/**/*.test.cjs",
      "bin/**/*",
      "dist/**/*",
      "runtime/**/*",
      "runtime-catalog/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "!node_modules/@earendil-works/**/*",
      "!node_modules/@agentclientprotocol/**/*",
      "scripts/prepare-runtime.mjs",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "apps/api/**/*",
      "bin/**/*",
      "dist/**/*",
      "runtime/**/*",
      "runtime-catalog/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "Frakio.Work-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "Frakio.Work-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Frakio.Work-${version}-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    }
  }
}
